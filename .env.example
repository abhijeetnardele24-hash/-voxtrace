# Do not commit real credentials. Add runtime secrets to a local .env file only.
# VoxTrace does not require a cloud key for its deterministic baseline engine.

# Optional: URL allowed to call the production API from the dashboard.
VOXTRACE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional WhisperX forced alignment. Keep disabled until the optional dependency
# is installed and its language model is pre-warmed on a sufficiently sized worker.
VOXTRACE_ENABLE_ALIGNMENT=false
VOXTRACE_ALIGNMENT_DEVICE=cpu
VOXTRACE_ALIGNMENT_CACHE_ONLY=true
